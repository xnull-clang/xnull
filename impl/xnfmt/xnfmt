#!/bin/sh
# XNull xnfmt 批处理驱动（M6-B1-02）。
# 核心格式化器是 XNull 二进制 xnfmt.bin；当前 B0 运行时对同进程多文件
# 批处理存在不稳定（信号 11），因此驱动按“一文件一进程”调用，保证原子性。
set -u
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bin="$here/xnfmt.bin"
if [ ! -x "$bin" ]; then
    echo "xnfmt: 缺少 XNull 二进制 $bin（先用 xnull build 构建）" >&2
    exit 2
fi
if [ "$#" -eq 0 ]; then
    echo "用法：xnfmt <file>..." >&2
    exit 2
fi
for f in "$@"; do
    "$bin" "$f" || exit 2
done
