// xdk.codec —— 编解码包：Base64 / URL / JSON / CSV / 二进制。
// 约定：
//   - Hex 编解码直接复用 xdk.sys 的 hexEncode/hexDecode；
//   - JsonValue 的对象侧用平行 List 实现（Map 对类值在源码层尚未接线，已知缺口）；
//   - \\uXXXX 转义 v1 返回错误（缺 Char←Int 构造原语）；
//   - 浮点位模式经 ext_raw 的 f32/f64 bits 原语。
package xdk.codec
import xdk.errors
import xdk.sys
import xdk.math

// ---------- Base64 ----------

































































































































































































































































































































































































































































































































































































































































































































































































class CsvTable {
    List<CsvRow> rows

    CsvTable() {
        self.rows = []
    }

    Int rowCount() {
        return self.rows.length()
    }

    // 越界返回空行。
    CsvRow row(Int i) {
        if i < 0 || i >= self.rows.length() {
            return new CsvRow()
        }
        return self.rows.get(i)
    }

    void addRow(CsvRow r) {
        self.rows.push(r)
    }
}
