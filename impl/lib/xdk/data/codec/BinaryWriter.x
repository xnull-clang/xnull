// xdk.codec —— 编解码包：Base64 / URL / JSON / CSV / 二进制。
// 约定：
//   - Hex 编解码直接复用 xdk.sys 的 hexEncode/hexDecode；
//   - JsonValue 的对象侧用平行 List 实现（Map 对类值在源码层尚未接线，已知缺口）；
//   - \\uXXXX 转义 v1 返回错误（缺 Char←Int 构造原语）；
//   - 浮点位模式经 ext_raw 的 f32/f64 bits 原语。
package xdk.codec
import xdk.errors
import xdk.sys
import xdk.math

// ---------- Base64 ----------

























































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































class BinaryWriter {
    Bytes buf

    BinaryWriter() {
        self.buf = Bytes.fromString("")
    }

    Bytes toBytes() {
        return self.buf
    }

    Int length() {
        return self.buf.length()
    }

    void writeU8(Int v) {
        self.buf.push(v % 256)
    }

    void writeU16le(Int v) {
        self.buf.push(v % 256)
        self.buf.push((v / 256) % 256)
    }

    void writeU16be(Int v) {
        self.buf.push((v / 256) % 256)
        self.buf.push(v % 256)
    }

    void writeU32le(Int v) {
        self.buf.push(v % 256)
        self.buf.push((v / 256) % 256)
        self.buf.push((v / 65536) % 256)
        self.buf.push((v / 16777216) % 256)
    }

    void writeU32be(Int v) {
        self.buf.push((v / 16777216) % 256)
        self.buf.push((v / 65536) % 256)
        self.buf.push((v / 256) % 256)
        self.buf.push(v % 256)
    }

    void writeU64le(Int64 v) {
        Int i = 0
        while i < 8 {
            self.buf.push((v / pow2(i * 8)) % 256)
            i = i + 1
        }
    }

    void writeU64be(Int64 v) {
        Int i = 7
        while i >= 0 {
            self.buf.push((v / pow2(i * 8)) % 256)
            i = i - 1
        }
    }

    void writeI32le(Int v) {
        if v < 0 {
            v = v + 4294967296
        }
        self.writeU32le(v)
    }

    void writeF32le(Double v) {
        self.writeU32le(f32BitsRaw(v))
    }

    void writeF64le(Double v) {
        self.writeU64le(f64BitsRaw(v))
    }

    void writeString(String s) {
        self.writeU64le(s.length())
        Int i = 0
        while i < s.length() {
            self.buf.push(s.get(i))
            i = i + 1
        }
    }

    void writeBytes(Bytes b) {
        Int i = 0
        while i < b.length() {
            self.buf.push(b.get(i))
            i = i + 1
        }
    }
}
