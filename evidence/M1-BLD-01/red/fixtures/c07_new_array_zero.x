static Int main() {
    Int[] ints = new Int[3]
    print(ints.length())
    print(ints[0])
    print(ints.join(","))
    Bool[] bools = new Bool[2]
    print(bools.join(","))
    Float[] floats = new Float[2]
    print(floats.join(","))
    String[] strs = new String[2]
    print(strs.join(","))
    Int n = 0
    print(new Int[n].length())
    return 0
}
