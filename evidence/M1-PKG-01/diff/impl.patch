new file mode 100644
index 0000000..b3ba57d
--- /dev/null
+++ b/impl/internal/sema/pkg.go
@@ -0,0 +1,252 @@
+package sema
+
+// PKG-01（S1 §3 包与导入）：跨文件/跨包符号表与导入诊断。
+//
+// 实现落点：
+//   - Package 是导入解析所需的最小包符号表（只含公开顶层符号）；
+//   - NewPackage 从编译单元提取符号表（public 默认；private/protected 不导出）；
+//   - AnalyzeWithDeps 在给定依赖包表时执行严格导入解析；
+//     Analyze（无依赖表）保持旧行为：用户包导入无法解析时延后未定义检查。
+//
+// 诊断码（§3.5）：
+//   RES-103 导入别名冲突
+//   RES-104 未消歧的简单名
+//   RES-105 XDK 包未显式导入
+//   RES-106 包或符号不存在
+//   RES-107 非冲突场景使用 as 别名（含禁止的包别名）
+//   RES-108 包导入环
+//   RES-111 默认包被跨包导入（本文件新增）
+
+import (
+	"sort"
+	"strings"
+
+	"xnull.dev/xnull/internal/diag"
+	"xnull.dev/xnull/internal/xfront"
+)
+
+const (
+	// ResImportCycle 包导入环（§3.4）。
+	ResImportCycle = "RES-108"
+	// ResDefaultPkg 默认包被其他包导入（§3.1/§3.5）。
+	ResDefaultPkg = "RES-111"
+)
+
+// Package 是一个被导入包的最小符号表。
+type Package struct {
+	Path    []string        // 导入路径（点分段）
+	Name    []string        // package 声明；nil 表示默认包
+	Symbols map[string]bool // 公开顶层符号
+	Imports [][]string      // 该包自身的导入路径（环检测用）
+}
+
+// NewPackage 从编译单元提取包符号表。
+// 只登记公开顶层符号：顶层 private/protected 等价于不可跨包导入（§3.1/§3.5）。
+func NewPackage(path []string, u *xfront.CompilationUnit) *Package {
+	p := &Package{Path: path, Symbols: map[string]bool{}}
+	if u == nil {
+		return p
+	}
+	if u.Package != nil {
+		p.Name = u.Package.Name
+	}
+	for _, imp := range u.Imports {
+		if len(imp.Path) > 0 {
+			p.Imports = append(p.Imports, imp.Path)
+		}
+	}
+	for _, d := range u.Decls {
+		switch n := d.(type) {
+		case *xfront.TopFunc:
+			if importableVis(n.Private, n.Protected) {
+				p.Symbols[n.Name] = true
+			}
+		case *xfront.TopField:
+			if importableVis(n.Private, n.Protected) {
+				p.Symbols[n.Name] = true
+			}
+		case *xfront.ClassDecl:
+			if importableTypeVis(n.Mod.Vis) {
+				p.Symbols[n.Name] = true
+			}
+		case *xfront.StructDecl:
+			if importableTypeVis(n.Mod.Vis) {
+				p.Symbols[n.Name] = true
+			}
+		case *xfront.ProtocolDecl:
+			// ProtocolDecl 当前无 Mod 字段（G-P1），按默认 public 处理。
+			p.Symbols[n.Name] = true
+		case *xfront.EnumDecl:
+			if importableTypeVis(n.Mod.Vis) {
+				p.Symbols[n.Name] = true
+			}
+		}
+	}
+	return p
+}
+
+func importableVis(private, protected bool) bool { return !private && !protected }
+
+func importableTypeVis(vis string) bool { return vis != "private" && vis != "protected" }
+
+// AnalyzeWithDeps 在给定依赖包符号表时执行语义分析。
+// deps 必须覆盖入口文件全部非 xdk 导入；缺项按"包不存在"（RES-106）诊断。
+func AnalyzeWithDeps(file string, u *xfront.CompilationUnit, deps []*Package) (*Result, []diag.Diagnostic) {
+	m := make(map[string]*Package, len(deps))
+	for _, d := range deps {
+		if d == nil || len(d.Path) == 0 {
+			continue
+		}
+		m[strings.Join(d.Path, ".")] = d
+	}
+	return analyzeWith(file, u, m)
+}
+
+// analyzeWith 是 AnalyzeWith/AnalyzeWithDeps 的共同实现。
+func analyzeWith(file string, u *xfront.CompilationUnit, deps map[string]*Package) (*Result, []diag.Diagnostic) {
+	a := &analyzer{file: file, tops: map[string]bool{}, seenTop: map[string]bool{},
+		imported: map[string]bool{}, ambiguous: map[string]bool{}, deps: deps}
+	a.analyzeImports(u)
+	a.checkTypeDecls(u)
+	for _, d := range u.Decls {
+		switch n := d.(type) {
+		case *xfront.TopFunc:
+			a.collectTop(n.Name, n.P)
+			for _, p := range n.Params {
+				a.collectTopParam(p.Name)
+			}
+		case *xfront.TopField:
+			a.collectTop(n.Name, n.P)
+		}
+	}
+	for _, d := range u.Decls {
+		if fn, ok := d.(*xfront.TopFunc); ok {
+			sc := &nscope{parent: nil}
+			for _, p := range fn.Params {
+				sc.define(p.Name)
+			}
+			a.walkBlock(fn.Body, sc)
+		}
+	}
+	// M2-B：确定赋值与返回路径（§5.3、§6.1）——名称解析之后。
+	for _, d := range u.Decls {
+		if fn, ok := d.(*xfront.TopFunc); ok {
+			a.analyzeAssign(file, fn)
+		}
+	}
+	// M2-C：类型检查（§2.6/§2.10/§6.1）——最后（依赖前两遍的环境）。
+	a.analyzeTypes(file, u)
+	return &Result{a: a}, a.diags
+}
+
+// topLevelNames 扫描当前文件的顶层声明名（函数/字段/类型）。
+// analyzeImports 早于 collectTop/类型登记，别名与遮蔽判定需要独立扫描（§3.3）。
+func topLevelNames(u *xfront.CompilationUnit) map[string]bool {
+	names := map[string]bool{}
+	for _, d := range u.Decls {
+		switch n := d.(type) {
+		case *xfront.TopFunc:
+			names[n.Name] = true
+		case *xfront.TopField:
+			names[n.Name] = true
+		case *xfront.ClassDecl:
+			names[n.Name] = true
+		case *xfront.StructDecl:
+			names[n.Name] = true
+		case *xfront.ProtocolDecl:
+			names[n.Name] = true
+		case *xfront.EnumDecl:
+			names[n.Name] = true
+		}
+	}
+	return names
+}
+
+// resolveUserImport 把导入路径解析为依赖包：
+//   - 整段命中依赖包 → 包导入，sym 为空；
+//   - 去掉末段命中依赖包 → 符号导入，sym 为末段；
+//   - 其余 → 未找到。
+func (a *analyzer) resolveUserImport(p []string) (*Package, string, bool) {
+	if len(p) == 0 {
+		return nil, "", false
+	}
+	if d, ok := a.deps[strings.Join(p, ".")]; ok {
+		return d, "", true
+	}
+	if len(p) >= 2 {
+		if d, ok := a.deps[strings.Join(p[:len(p)-1], ".")]; ok {
+			return d, p[len(p)-1], true
+		}
+	}
+	return nil, "", false
+}
+
+// samePackage 判断依赖是否属于当前编译单元（同包分片，§3.4 起步形态）。
+func samePackage(u *xfront.CompilationUnit, dep *Package) bool {
+	if u.Package == nil {
+		return len(dep.Name) == 0
+	}
+	return len(dep.Name) > 0 && strings.Join(u.Package.Name, ".") == strings.Join(dep.Name, ".")
+}
+
+// checkImportCycle 检查包导入图是否有环（§3.4）。只报告第一个环。
+func (a *analyzer) checkImportCycle(u *xfront.CompilationUnit) {
+	if a.deps == nil {
+		return
+	}
+	const (
+		gray  = 1
+		black = 2
+	)
+	state := map[string]int{}
+	var stack []string
+	reported := false
+
+	var visit func(p []string, pos xfront.Pos)
+	visit = func(p []string, pos xfront.Pos) {
+		if reported || len(p) == 0 || p[0] == "xdk" {
+			return
+		}
+		dep, _, ok := a.resolveUserImport(p)
+		if !ok {
+			return
+		}
+		k := strings.Join(dep.Path, ".")
+		switch state[k] {
+		case gray:
+			chain := append(append([]string{}, stack...), k)
+			a.errf(pos, ResImportCycle, "包导入图存在环（§3.4）："+strings.Join(chain, " → "),
+				"拆出公共依赖包，消除互相 import")
+			reported = true
+			return
+		case black:
+			return
+		}
+		state[k] = gray
+		stack = append(stack, k)
+		for _, imp := range dep.Imports {
+			visit(imp, pos)
+			if reported {
+				return
+			}
+		}
+		stack = stack[:len(stack)-1]
+		state[k] = black
+	}
+	for _, imp := range u.Imports {
+		visit(imp.Path, imp.P)
+		if reported {
+			return
+		}
+	}
+}
+
+// sortedKeys 返回确定性排序的符号名（诊断顺序稳定，DET-01）。
+func sortedKeys(m map[string]bool) []string {
+	out := make([]string, 0, len(m))
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
diff --git a/impl/internal/sema/pkg_test.go b/impl/internal/sema/pkg_test.go
new file mode 100644
index 0000000..484b2cf
--- /dev/null
+++ b/impl/internal/sema/pkg_test.go
@@ -0,0 +1,366 @@
+package sema
+
+import (
+	"strings"
+	"testing"
+
+	"xnull.dev/xnull/internal/xfront"
+)
+
+// ---------- PKG-01（S1 §3.2/§3.4/§3.5）：包导入 / 符号导入 / 别名 / 歧义 / 导入环 ----------
+
+// depPkg 解析一个依赖包源文本并构造符号表。
+func depPkg(t *testing.T, path, src string) *Package {
+	t.Helper()
+	u, ds := xfront.ParseUnit(path+".x", src)
+	if len(ds) != 0 {
+		t.Fatalf("依赖包 %s 解析诊断：%v", path, ds)
+	}
+	return NewPackage(strings.Split(path, "."), u)
+}
+
+// codesWithDeps 分析入口单元并返回诊断码集合。
+func codesWithDeps(t *testing.T, src string, deps ...*Package) []string {
+	t.Helper()
+	u, ds := xfront.ParseUnit("entry.x", src)
+	if len(ds) != 0 {
+		t.Fatalf("入口解析诊断：%v", ds)
+	}
+	_, sd := AnalyzeWithDeps("entry.x", u, deps)
+	out := make([]string, 0, len(sd))
+	for _, d := range sd {
+		out = append(out, d.Code)
+	}
+	return out
+}
+
+func wantNoneWithDeps(t *testing.T, src string, deps ...*Package) {
+	t.Helper()
+	if got := codesWithDeps(t, src, deps...); len(got) != 0 {
+		t.Fatalf("不应有语义诊断，实际：%v（源：%s）", got, src)
+	}
+}
+
+func wantCodeWithDeps(t *testing.T, src, code string, deps ...*Package) {
+	t.Helper()
+	for _, c := range codesWithDeps(t, src, deps...) {
+		if c == code {
+			return
+		}
+	}
+	t.Fatalf("期望诊断 %s，实际：%v（源：%s）", code, codesWithDeps(t, src, deps...), src)
+}
+
+func textDep(t *testing.T) *Package {
+	t.Helper()
+	return depPkg(t, "lib.text", `package lib.text
+
+String banner(String s) { return "[" + s + "]" }
+
+static String shout(String s) { return banner(s) }
+
+private String secret() { return "s" }
+
+protected String guard() { return "g" }
+`)
+}
+
+// ---------- ① 包导入 ----------
+
+func TestPkgImport(t *testing.T) {
+	text := textDep(t)
+
+	// import P 引入 P 的全部公开顶层符号（§3.2）
+	wantNoneWithDeps(t, `package app
+
+import lib.text
+
+static Int main() {
+    String b = banner("x")
+    String c = shout(b)
+    return 0
+}`, text)
+
+	// 包导入不绑定包命名空间别名（§3.2）
+	wantCodeWithDeps(t, `package app
+
+import lib.text
+
+static Int main() {
+    String b = text.banner("x")
+    return 0
+}`, ResUndefined, text)
+
+	// 顶层 private / protected 不可导入（§3.1/§3.5）
+	wantCodeWithDeps(t, `package app
+import lib.text
+static Int main() {
+    String s = secret()
+    return 0
+}`, ResUndefined, text)
+	wantCodeWithDeps(t, `package app
+import lib.text
+static Int main() {
+    String s = guard()
+    return 0
+}`, ResUndefined, text)
+
+	// 当前包顶层声明遮蔽同名导入（§3.3），不是歧义
+	wantNoneWithDeps(t, `package app
+
+import lib.text
+
+String banner(String s) { return s }
+
+static Int main() {
+    String b = banner("x")
+    return 0
+}`, text)
+}
+
+// ---------- ② 符号导入 ----------
+
+func TestSymbolImport(t *testing.T) {
+	text := textDep(t)
+
+	// import P.S 只引入 S（§3.2）
+	wantNoneWithDeps(t, `package app
+
+import lib.text.banner
+
+static Int main() {
+    String b = banner("x")
+    return 0
+}`, text)
+
+	// 同包其他符号不因符号导入而可见
+	wantCodeWithDeps(t, `package app
+
+import lib.text.banner
+
+static Int main() {
+    String c = shout("x")
+    return 0
+}`, ResUndefined, text)
+
+	// 符号不存在（§3.5）
+	wantCodeWithDeps(t, `package app
+
+import lib.text.Nope
+
+static Int main() { return 0 }
+`, ResNotFound, text)
+
+	// 私有符号不能被符号导入（§3.5）
+	wantCodeWithDeps(t, `package app
+
+import lib.text.secret
+
+static Int main() { return 0 }
+`, ResNotFound, text)
+}
+
+// ---------- ③ 同名消歧别名 ----------
+
+func TestAliasDisambiguation(t *testing.T) {
+	a := depPkg(t, "lib.a", "package lib.a\n\nInt Thing(Int x) { return x }\n")
+	b := depPkg(t, "lib.b", "package lib.b\n\nInt Thing(Int x) { return x + 1 }\n")
+
+	// 两处同名符号各自用 as 消歧 → 合法（§3.2）
+	wantNoneWithDeps(t, `package app
+
+import lib.a.Thing as AThing
+import lib.b.Thing as BThing
+
+static Int main() {
+    return AThing(1) + BThing(2)
+}`, a, b)
+
+	// 别名替换原简单名：原简单名不可再裸用
+	wantCodeWithDeps(t, `package app
+
+import lib.a.Thing as AThing
+import lib.b.Thing as BThing
+
+static Int main() {
+    return Thing(1)
+}`, ResUndefined, a, b)
+
+	// 一处消歧、一处裸导入 → 合法；裸导入的简单名仍可用
+	wantNoneWithDeps(t, `package app
+
+import lib.a.Thing as AThing
+import lib.b.Thing
+
+static Int main() {
+    return AThing(1) + Thing(2)
+}`, a, b)
+}
+
+// ---------- ④ 非冲突别名被拒绝 ----------
+
+func TestNeedlessAliasRejected(t *testing.T) {
+	text := textDep(t)
+
+	// 单一符号导入使用 as → RES-107（§3.2）
+	wantCodeWithDeps(t, `package app
+
+import lib.text.banner as B
+
+static Int main() { return 0 }
+`, ResNeedlessAlias, text)
+
+	// 包导入不得使用 as 包别名（§3.2）→ RES-107
+	wantCodeWithDeps(t, `package app
+
+import lib.text as T
+
+static Int main() { return 0 }
+`, ResNeedlessAlias, text)
+
+	// XDK 包别名同样拒绝（§3.2）
+	expectCode(t, `import xdk.text as T
+
+static Int main() { return 0 }
+`, ResNeedlessAlias)
+
+	// 别名冲突：同一别名指向两个符号（§3.5）→ RES-103
+	a := depPkg(t, "lib.a", "package lib.a\n\nInt Thing(Int x) { return x }\n")
+	b := depPkg(t, "lib.b", "package lib.b\n\nInt Thing(Int x) { return x }\n")
+	wantCodeWithDeps(t, `package app
+
+import lib.a.Thing as P
+import lib.b.Thing as P
+
+static Int main() { return 0 }
+`, ResAliasConflict, a, b)
+
+	// 别名不得与当前文件顶层声明冲突（§3.3）→ RES-103
+	wantCodeWithDeps(t, `package app
+
+import lib.a.Thing as P
+
+Int P = 1
+
+static Int main() { return P }
+`, ResAliasConflict, a)
+
+	// 别名不得与预定义类型名冲突（§3.3）→ RES-103
+	wantCodeWithDeps(t, `package app
+
+import lib.a.Thing as Int
+
+static Int main() { return 0 }
+`, ResAliasConflict, a)
+}
+
+// ---------- ⑤ 简单名歧义 ----------
+
+func TestAmbiguousSimpleName(t *testing.T) {
+	a := depPkg(t, "lib.a", "package lib.a\n\nInt Thing(Int x) { return x }\n")
+	b := depPkg(t, "lib.b", "package lib.b\n\nInt Thing(Int x) { return x + 1 }\n")
+
+	// 两个导入提供同一简单名且未消歧 → RES-104（§3.2/§3.5）
+	wantCodeWithDeps(t, `package app
+
+import lib.a.Thing
+import lib.b.Thing
+
+static Int main() { return Thing(1) }
+`, ResAmbiguousName, a, b)
+
+	// 重复导入同一包/同一符号允许，不产生新绑定（§3.2）
+	wantNoneWithDeps(t, `package app
+
+import lib.a.Thing
+import lib.a.Thing
+
+static Int main() { return Thing(1) }
+`, a)
+	expectNone(t, `import xdk.text
+import xdk.text
+
+static Int main() { return 0 }
+`)
+}
+
+// ---------- ⑥ XDK 未导入 ----------
+
+func TestXdkNotImportedStrict(t *testing.T) {
+	// 未导入即使用 XDK 静态入口 → RES-105（§3.2/§3.5）
+	expectCode(t, `static Int main() {
+    diagnose("x")
+    return 0
+}`, ResXdkNotImport)
+
+	// 显式导入后可用
+	expectNone(t, `import xdk.runtime
+
+static Int main() {
+    diagnose("x")
+    return 0
+}`)
+
+	// 其他（用户包）导入不能掩盖 XDK 未导入
+	text := textDep(t)
+	wantCodeWithDeps(t, `package app
+
+import lib.text
+
+static Int main() {
+    diagnose("x")
+    return 0
+}`, ResXdkNotImport, text)
+}
+
+// ---------- ⑦ 导入环 ----------
+
+func TestImportCycle(t *testing.T) {
+	a := depPkg(t, "lib.a", "package lib.a\n\nimport lib.b\n\nInt fa() { return 1 }\n")
+	b := depPkg(t, "lib.b", "package lib.b\n\nimport lib.a\n\nInt fb() { return 2 }\n")
+
+	// 入口 → lib.a → lib.b → lib.a → RES-108（§3.4）
+	wantCodeWithDeps(t, `package app
+
+import lib.a
+
+static Int main() { return fa() }
+`, ResImportCycle, a, b)
+
+	// 无环链：lib.a → lib.c 合法
+	c := depPkg(t, "lib.c", "package lib.c\n\nInt fc() { return 3 }\n")
+	a2 := depPkg(t, "lib.a", "package lib.a\n\nimport lib.c\n\nInt fa() { return fc() }\n")
+	wantNoneWithDeps(t, `package app
+
+import lib.a
+
+static Int main() { return fa() }
+`, a2, c)
+}
+
+// ---------- 包不存在 / 默认包 ----------
+
+func TestImportTargetRules(t *testing.T) {
+	// 包不存在 → RES-106（§3.5）
+	wantCodeWithDeps(t, `package app
+
+import lib.none
+
+static Int main() { return 0 }
+`, ResNotFound)
+
+	// 默认包不能被其他包导入（§3.1/§3.5）→ RES-111
+	plain := depPkg(t, "lib.plain", "Int helper() { return 1 }\n")
+	wantCodeWithDeps(t, `package app
+
+import lib.plain
+
+static Int main() { return helper() }
+`, ResDefaultPkg, plain)
+
+	// 默认包入口导入默认包文件：同一编译单元分片，允许（examples/multi 形态）
+	wantNoneWithDeps(t, `import lib.plain
+
+static Int main() { return helper() }
+`, plain)
+}
