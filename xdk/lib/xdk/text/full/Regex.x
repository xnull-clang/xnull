// xdk.text 完整实现（源码层过渡单元，仅 XNULL_XDK_SOURCE=1 编入）
//
// 与 src/xdk/text.x（默认构建面）同源；追加顶层工厂与 Utf16 包装。
// 默认构建不加载本单元，避免改变冻结 golden。
//
// 依赖：xdk.errors（错误值）；C 原语对应 src/runtime/rt_std_text.c
// （parse_int/parse_float/utf8_to_utf16/utf16_to_utf8/regex_match；解释器路径由等价源码执行）。
// 稳定性：@preview。
// 合同：可失败操作返回 Result；Regex 动态编译失败是可恢复错误，不 panic。
package xdk.text
import xdk.errors

// ---------- 格式化 builder ----------

// Format：链式格式化构造器（Format.int(7).width(4).pad('0').build()）。
































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































class Regex {
    final String pattern;
    RegexTree t
    Int groupCount
    Bool anchored
    Int root

    Regex(String pattern) {
        self.pattern = pattern
        self.t = new RegexTree()
        self.groupCount = 0
        self.anchored = false
        self.root = 0
    }

    Bool isMatch(String text) {
        return self.find(text) != null
    }

    // 首个匹配；未找到返回 null。
    Match? find(String text) {
        Int start = 0
        while start <= text.length() {
            RegexMatcher m = new RegexMatcher(self.t, text, self.groupCount)
            Int end = m.matchOne(self.root, start)
            if end >= start {
                return new Match(start, end, self.collectGroups(m))
            }
            if self.anchored {
                return null
            }
            start = start + 1
        }
        return null
    }

    List<String> collectGroups(RegexMatcher m) {
        List<String> out = []
        Int i = 0
        while i < self.groupCount {
            Int s = m.st.starts.get(i)
            Int e = m.st.ends.get(i)
            if s >= 0 && e >= s {
                out.push(m.text.substring(s, e - s))
            } else {
                out.push("")
            }
            i = i + 1
        }
        return out
    }

    // 非空匹配列表（空匹配跳过并前进 1 字节）。
    List<Match> findAll(String text) {
        List<Match> out = []
        Int start = 0
        while start < text.length() {
            RegexMatcher m = new RegexMatcher(self.t, text, self.groupCount)
            Int end = m.matchOne(self.root, start)
            if end > start {
                out.push(new Match(start, end, self.collectGroups(m)))
                start = end
                continue
            }
            if self.anchored {
                break
            }
            start = start + 1
        }
        return out
    }

    // 把全部非空匹配替换为 repl。
    String replaceAll(String text, String repl) {
        String out = ""
        Int pos = 0
        while pos < text.length() {
            RegexMatcher m = new RegexMatcher(self.t, text, self.groupCount)
            Int e = m.matchOne(self.root, pos)
            if e > pos {
                out = out + repl
                pos = e
                continue
            }
            out = out + text.substring(pos, 1)
            pos = pos + 1
        }
        return out
    }

    // 按非空匹配切分。
    List<String> split(String text) {
        List<String> out = []
        Int pos = 0
        Int last = 0
        while pos < text.length() {
            RegexMatcher m = new RegexMatcher(self.t, text, self.groupCount)
            Int e = m.matchOne(self.root, pos)
            if e > pos {
                out.push(text.substring(last, pos - last))
                pos = e
                last = e
                continue
            }
            pos = pos + 1
        }
        out.push(text.substring(last, text.length() - last))
        return out
    }
}
