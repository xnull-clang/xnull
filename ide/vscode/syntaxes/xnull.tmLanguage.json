{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XNull",
  "scopeName": "source.xnull",
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.xnull",
          "match": "//.*$"
        },
        {
          "name": "comment.block.xnull",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.xnull",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.xnull",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.raw.xnull",
          "begin": "r\"",
          "end": "\""
        },
        {
          "name": "string.quoted.double.xnull",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.xnull", "match": "\\\\." }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.xnull",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.xnull", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.xnull",
          "match": "\\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*)([uUlL]*)\\b"
        },
        {
          "name": "constant.numeric.float.xnull",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?[fF]?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xnull",
          "match": "\\b(if|else|while|do|for|in|switch|case|default|break|continue|return|throw|try|defer|errdefer|goto|is|as)\\b"
        },
        {
          "name": "keyword.other.xnull",
          "match": "\\b(package|import|class|struct|protocol|enum|singleton|factory|extension|annotation|new|self|super|static|final|const|var|public|protected|private|abstract|override|void|true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.xnull",
          "match": "\\b(Int|UInt|Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Int128|UInt128|Long|ULong|Byte|Short|UByte|UShort|Float|Float32|Float64|Double|Bool|Char|String|Text|Bytes|StringBuilder|Any|Object|List|Map|Set|Result|Range)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.xnull",
          "match": "\\b(print|str|Ok|Err)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.xnull",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.xnull",
          "match": "===|!==|==|!=|<=|>=|&&|\\|\\||\\.\\.<|\\.\\.\\.|\\?\\?|=>|->|\\+\\+|--|\\+=|-=|\\*=|/=|%=|<<|>>|[+\\-*/%<>=!&|^~?:.]"
        }
      ]
    }
  }
}
