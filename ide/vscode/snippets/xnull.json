{
  "XNull main": {
    "prefix": "main",
    "body": [
      "static Int main() {",
      "    print(\"hello, XNull\")",
      "    return 0",
      "}"
    ],
    "description": "Minimal XNull entry point"
  },
  "XNull main(args)": {
    "prefix": "mainargs",
    "body": [
      "static Int main(String[] args) {",
      "    print(\"hello, XNull\")",
      "    return 0",
      "}"
    ],
    "description": "XNull entry point with program arguments"
  },
  "XNull function": {
    "prefix": "func",
    "body": [
      "static ${1:Int} ${2:name}(${3:Int value}) {",
      "    ${4:return 0}",
      "}"
    ],
    "description": "Top-level function"
  },
  "XNull class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "    ${2:Int value = 0}",
      "",
      "    ${3:Int} ${4:get}() {",
      "        return self.${2:value}",
      "    }",
      "}"
    ],
    "description": "Class declaration"
  },
  "XNull struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${2:Int value = 0}",
      "}"
    ],
    "description": "Value struct declaration"
  },
  "XNull enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "    ${2:First},",
      "    ${3:Second}",
      "}"
    ],
    "description": "Simple enum declaration"
  },
  "XNull Result function": {
    "prefix": "resultfn",
    "body": [
      "static Result<${1:Int}, ${2:String}> ${3:name}(${4:Int value}) {",
      "    if ${4:value} < 0 {",
      "        return Err(\"negative\")",
      "    }",
      "    return Ok(${4:value})",
      "}"
    ],
    "description": "Function returning Result"
  },
  "XNull try": {
    "prefix": "try",
    "body": [
      "${1:Int} ${2:value} = try ${3:call()}",
      ""
    ],
    "description": "Propagate a Result with try"
  },
  "XNull defer": {
    "prefix": "defer",
    "body": [
      "defer {",
      "    ${1:// cleanup}",
      "}"
    ],
    "description": "Deferred cleanup"
  },
  "XNull errdefer": {
    "prefix": "errdefer",
    "body": [
      "errdefer {",
      "    ${1:// compensation}",
      "}"
    ],
    "description": "Error-path cleanup"
  },
  "XNull if": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    ${2:}",
      "}"
    ],
    "description": "If block"
  },
  "XNull for-in": {
    "prefix": "forin",
    "body": [
      "for ${1:item} in ${2:items} {",
      "    ${3:}",
      "}"
    ],
    "description": "For-in loop"
  },
  "XNull switch": {
    "prefix": "switch",
    "body": [
      "switch ${1:value} {",
      "    case ${2:1}:",
      "        ${3:}",
      "    default:",
      "        ${4:}",
      "}"
    ],
    "description": "Switch block"
  }
}
