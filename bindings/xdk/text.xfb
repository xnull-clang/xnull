// bindings/xdk/text.xfb —— xdk.text 的 C 原语绑定（S6 §4.6 / XDK-08）
//
// 公开语言面由 XNull 源码单元 impl/lib/xdk/text.x 提供（Format/parseInt/
// parseFloat/utf8ToUtf16/utf16ToUtf8/Regex）。本文件只声明可由 FFI 合同表达的
// C 原语；parseInt/parseFloat/UTF 转换使用出参指针，FFI 编组暂不支持（BOUND-02
// 禁止 Result/Optional，出参指针亦无 marshalling），待 E5 提供值返回包装或
// E4 后续补 out 编组；Regex 原语按返回值表达，可完整跨界。
ffi xdkc_text {
  // 0 = 匹配；1 = 不匹配；2 = 模式语法错误/长度非法（S6 §4.6，显式区分）。
  @ffiEntry(cName = "xdkc_regex_match")
  @lease(pat = .borrow, sub = .borrow)
  @blocking(.aware)
  Int regexMatch(String pat, String sub);
}
