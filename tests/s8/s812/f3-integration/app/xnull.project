project {
  groupId = s812
  artifactId = app
  version = 1.0.0
  packaging = app
  properties {
    xdk-version = 1.0.0
    language-version = 3.3.0
    appName = demo
  }
  profiles {
    profile dev {
      properties {
        appName = demo-dev
      }
      configuration {
        app.env = dev-manifest
      }
    }
  }
  configuration {
    app.name = ${appName}
    app.env = base
    net.port = 8080
    feature.flag = true
  }
  build {
    resources {
      resource src/main/resources {
        includes = [**]
        excludes = [**/*.psd]
      }
      resource extra/resources {
        includes = [conf/**]
      }
    }
    plugins {
      plugin com.example:codegen 1.2.0 {
        phase = validate
        goal = check
        configuration {
          output = target/gen
        }
      }
    }
  }
}
