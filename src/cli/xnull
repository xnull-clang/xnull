#!/usr/bin/env bash
# XNull unified CLI — mini only.
#
# mini is the canonical compiler. There is no fallback.
# Project/package commands are intentionally absent until mini can run them;
# the single-file build/run/check surface is the current xnull product.
set -uo pipefail
trap 'exit 130' INT
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$HERE/../.." && pwd)
IMPL="$ROOT/src/toolchain/xnull-build.sh"
[ -x "$IMPL" ] || { echo "xnull: 找不到 $IMPL" >&2; exit 2; }

# --bootstrap is kept as a no-op for existing scripts; mini is the only engine.
BOOT=${XNULL_USE_BOOTSTRAP:-0}
ENGINE=${XNULL_ENGINE:-mini}
while [ $# -gt 0 ]; do
  case "$1" in
    --bootstrap) BOOT=1; shift ;;
    --engine=*) ENGINE=${1#--engine=}; shift ;;
    --engine)
      [ $# -ge 2 ] || { echo "xnull: [CLI-002] --engine 缺参数" >&2; exit 2; }
      ENGINE=$2; shift 2 ;;
    *) break ;;
  esac
done
case "$ENGINE" in
  mini|auto) ENGINE=mini ;;
  *)
    echo "xnull: [CLI-002] 未知引擎：${ENGINE}（仅支持 mini）" >&2
    exit 2
    ;;
esac
export XNULL_ENGINE=mini
[ "$BOOT" = 1 ] && export XNULL_BOOTSTRAP=1

case "${1:-}" in
  ""|-h|--help|help)
    cat >&2 <<'EOF'
用法：xnull [--bootstrap] [--engine=mini] <命令> [参数…]
  --bootstrap                             兼容旧脚本；mini 是唯一引擎
  --engine=mini                           唯一引擎（auto 等价于 mini）
  build <entry.x> [-o out] [--emit-c-only] [--resources dir]
                                          单文件构建
  run   <entry.x> [-- 参数…]              构建并运行
  check <entry.x> [--json]                语法/类型检查
  version                                 版本信息
  clean [目录] [--all]                    清理 target/cache
  doctor                                  环境自检
EOF
    exit 2
    ;;
  -v|--version|version)
    exec "$IMPL" version
    ;;
  build|run|check|clean|doctor)
    exec "$IMPL" "$@"
    ;;
  validate|tree|why|install|lock|repro|xmeta|fmt|examples|bootstrap-*|build-project|run-project)
    echo "xnull: '$1' is not available in the mini-only surface yet" >&2
    exit 2
    ;;
  *)
    exec "$IMPL" "$@"
    ;;
esac
