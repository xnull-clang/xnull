// xdk-raw/runtime_raw.xfb —— xdk.runtime 源码层的原语桥（raw-only 投影）
//
// 冻结编译器在混合绑定集下会错位部分 FFI 包装参数；这里只暴露
// diagnose / exit / nowMono / nowWall / dumpTasks 与只读运行时信息，
// 命名带 Raw 后缀。
ffi xdkc_runtime_raw {
  @ffiEntry(cName = "xdkc_diagnose_rc")
  @lease(msg = .borrow)
  @blocking(.unaware)
  Int32 diagnoseRaw(String msg);

  @ffiEntry(cName = "xdkc_exit_rc")
  @lease(code = .borrow)
  @blocking(.unaware)
  Int32 exitRaw(Int32 code);

  @ffiEntry(cName = "xdkc_now_mono_ms")
  @blocking(.unaware)
  Int64 nowMonoRaw();

  @ffiEntry(cName = "xdkc_now_wall_ms")
  @blocking(.unaware)
  Int64 nowWallRaw();

  @ffiEntry(cName = "xdkc_dump_tasks")
  @blocking(.unaware)
  void dumpTasksRaw();

  // ---- 运行时信息 ----
  @ffiEntry(cName = "xdkc_platform")
  @blocking(.unaware)
  String runtimePlatformRaw();

  @ffiEntry(cName = "xdkc_arch")
  @blocking(.unaware)
  String runtimeArchRaw();

  @ffiEntry(cName = "xdkc_build_mode")
  @blocking(.unaware)
  String buildModeRaw();

  @ffiEntry(cName = "xdkc_build_date")
  @blocking(.unaware)
  String buildDateRaw();

  // ---- 分配/GC 统计（S3 §21/§23）----
  @ffiEntry(cName = "xdkc_stats_allocs")
  @blocking(.unaware)
  Int64 statsAllocsRaw();

  @ffiEntry(cName = "xdkc_stats_frees")
  @blocking(.unaware)
  Int64 statsFreesRaw();

  @ffiEntry(cName = "xdkc_stats_bytes")
  @blocking(.unaware)
  Int64 statsBytesRaw();

  @ffiEntry(cName = "xdkc_stats_gc_collections")
  @blocking(.unaware)
  Int64 statsGcCollectionsRaw();

  @ffiEntry(cName = "xdkc_stats_gc_freed")
  @blocking(.unaware)
  Int64 statsGcFreedRaw();

  @ffiEntry(cName = "xdkc_stats_enabled")
  @blocking(.unaware)
  Int32 statsEnabledRaw();

  @ffiEntry(cName = "xdkc_stats_set_enabled")
  @blocking(.unaware)
  Int32 statsSetEnabledRaw(Int32 enabled);

  @ffiEntry(cName = "xdkc_stats_reset")
  @blocking(.unaware)
  void statsResetRaw();

  // ---- GC 强制收集（测试/诊断）----
  @ffiEntry(cName = "xdkc_gc_collect")
  @blocking(.unaware)
  Int64 gcCollectRaw();

  // ---- 执行层内部监视器（B3.1）----
  // 句柄为进程级不透明地址；close 幂等，之后 wait 立即返回。
  @ffiEntry(cName = "xdkc_monitor_new")
  @blocking(.unaware)
  Int64 monitorNewRaw();

  @ffiEntry(cName = "xdkc_monitor_enter")
  @blocking(.unaware)
  void monitorEnterRaw(Int64 handle);

  @ffiEntry(cName = "xdkc_monitor_exit")
  @blocking(.unaware)
  void monitorExitRaw(Int64 handle);

  @ffiEntry(cName = "xdkc_monitor_wait")
  @blocking(.unaware)
  void monitorWaitRaw(Int64 handle);

  // 返回 1 = 已通知/已关闭；0 = 上下文已取消。
  @ffiEntry(cName = "xdkc_monitor_wait_context")
  @blocking(.unaware)
  Int32 monitorWaitContextRaw(Int64 handle, Context context);

  // 返回 0 = 取消；1 = 通知/关闭；2 = 到达 deadline。
  @ffiEntry(cName = "xdkc_monitor_wait_deadline")
  @blocking(.unaware)
  Int32 monitorWaitDeadlineRaw(Int64 handle, Context context, Int64 deadlineMonoMillis);

  @ffiEntry(cName = "xdkc_monitor_notify_all")
  @blocking(.unaware)
  void monitorNotifyAllRaw(Int64 handle);

  @ffiEntry(cName = "xdkc_monitor_close")
  @blocking(.unaware)
  void monitorCloseRaw(Int64 handle);

  @ffiEntry(cName = "xdkc_monitor_closed")
  @blocking(.unaware)
  Int32 monitorClosedRaw(Int64 handle);
}
