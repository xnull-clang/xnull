package xdk.text
import xdk.errors

// ---------- 格式化 builder ----------

// Format：链式格式化构造器（Format.int(7).width(4).pad('0').build()）。





































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































class Match {
    Int start
    Int end
    List<String> groups

    Match(Int s, Int e, List<String> gs) {
        self.start = s
        self.end = e
        self.groups = gs
    }

    Int len() {
        return self.end - self.start
    }

    // group(0) 为整匹配；i≥1 为捕获组（未捕获为空串）。
    String group(Int i) {
        if i - 1 >= self.groups.length() {
            return ""
        }
        if i - 1 < 0 {
            return ""
        }
        return self.groups.get(i - 1)
    }
}
