{
  "manifestVersion": 1,
  "processors": [
    {
      "name": "codec_processor",
      "phases": ["Generate"],
      "command": ["python3", "../../../toolchain/processors/codec_processor.py"],
      "outputs": ["CodecGenerated.x"],
      "timeoutSeconds": 30,
      "priority": 0
    },
    {
      "name": "csv_processor",
      "phases": ["Generate"],
      "command": ["python3", "../../../toolchain/processors/csv_processor.py"],
      "outputs": ["CsvGenerated.x"],
      "timeoutSeconds": 30,
      "priority": 1
    }
  ]
}
