import xdk.stats
static Int main() {
    List<Double> bounds = [1.0, 2.0]
    BucketHistogram hist = new BucketHistogram(bounds)
    hist.observe(0.5)
    hist.observe(1.5)
    hist.observe(3.0)
    print(hist.count())
    print(hist.sum())
    print(hist.mean())
    print(hist.min())
    print(hist.max())
    print(hist.buckets().length())
    print(hist.percentile(50.0))
    print(hist.merge(new BucketHistogram(bounds)))
    Summary summary = new Summary()
    summary.observe(1.0)
    summary.observe(2.0)
    summary.observe(3.0)
    print(summary.quantile(0.5))
    print(summary.mean())
    print(summary.variance())
    print(summary.merge(new Summary()).count())
    RunningStats running = new RunningStats()
    running.add(1.0)
    running.add(3.0)
    print(running.mean())
    print(running.variance())
    print(running.sampleVariance())
    List<Double> xs = [1.0, 2.0, 3.0]
    List<Double> ys = [2.0, 4.0, 6.0]
    Regression regression = new Regression(xs, ys)
    print(regression.slope())
    print(regression.predict(4.0))
    print(regression.r2())
    MovingAverage moving = new MovingAverage(2)
    moving.add(1.0)
    moving.add(3.0)
    moving.add(5.0)
    print(moving.average())
    print(moving.isFull())
    Ema ema = new Ema(0.5)
    ema.add(2.0)
    ema.add(4.0)
    print(ema.value())
    print(ema.count())
    return 0
}
