import xdk.graph
static Int main() {
    Graph<String> g = new Graph<String>()
    g.addNode("compile")
    g.addNode("link")
    g.addNode("test")
    GraphEdge<String> e1 = new GraphEdge<String>("compile", "link", 1.0)
    GraphEdge<String> e2 = new GraphEdge<String>("link", "test", 2.0)
    g.addEdge(e1)
    g.addEdge(e2)
    print(g.nodeCount())
    print(g.edgeCount())
    print(g.hasNode("link"))
    print(g.hasEdge("compile", "link"))
    print(g.hasEdge("link", "compile"))
    print(g.neighbors("compile").get(0))
    print(g.nodes().get(2))
    print(g.edges().get(1).to())
    print(g.bfs("compile").length())
    print(g.dfs("compile").get(1))
    print(g.hasCycle())
    Result<List<String>, Error> sorted = g.topologicalSort()
    print(sorted.isOk())
    print(sorted.value().get(0))
    Result<List<String>, Error> path = g.shortestPath("compile", "test")
    print(path.isOk())
    print(path.value().get(1))
    print(g.shortestPath("test", "compile").isErr())
    print(g.shortestPath("compile", "missing").isErr())
    print(e1.describe())
    print(e1.isSelfLoop())

    Graph<Int> gi = new Graph<Int>()
    gi.addNode(1)
    gi.addNode(2)
    GraphEdge<Int> loop = new GraphEdge<Int>(1, 1, 0.5)
    gi.addEdge(loop)
    gi.addEdge(new GraphEdge<Int>(1, 2, 1.0))
    print(gi.hasEdge(1, 1))
    print(gi.hasCycle())
    print(gi.neighbors(1).length())
    print(gi.topologicalSort().isErr())
    print(loop.isSelfLoop())
    print(loop.from())
    print(loop.to())

    g.removeEdge("compile", "link")
    print(g.edgeCount())
    g.removeNode("link")
    print(g.hasNode("link"))
    print(g.hasEdge("compile", "link"))
    g.removeNode("missing")
    g.removeEdge("compile", "missing")
    print(g.nodeCount())
    return 0
}
