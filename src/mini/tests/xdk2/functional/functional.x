import xdk.functional

static Int main() {
    List<Int> items = [1, 2, 2, 3, 4]
    Seq<Int> seq = new Seq<Int>(items)
    print(seq.length())
    print(seq.isEmpty())
    print(seq.get(0))
    print(seq.map((Int value) -> value * 2).get(2))
    print(seq.filter((Int value) -> value % 2 == 0).length())
    print(seq.flatMap((Int value) -> [value, value]).length())
    print(seq.distinct().length())
    print(seq.sorted((Int left, Int right) -> left - right).get(0))
    print(seq.reversed().get(0))
    print(seq.take(2).length())
    print(seq.skip(3).length())
    print(seq.takeWhile((Int value) -> value < 3).length())
    print(seq.dropWhile((Int value) -> value < 3).length())
    print(seq.chunk(2).length())
    print(seq.window(2).length())
    print(seq.zip(seq).length())
    print(seq.zip(seq).get(0).first())
    List<Int> empty = []
    print(seq.groupBy((Int value) -> str(value % 2)).getOr("0", empty).length())
    print(seq.partition((Int value) -> value > 2).first().length())
    print(seq.reduce(0, (Int left, Int right) -> left + right))
    print(seq.anyMatch((Int value) -> value == 4))
    print(seq.allMatch((Int value) -> value > 0))
    print(seq.noneMatch((Int value) -> value < 0))
    print(seq.firstOrNull())
    print(seq.count((Int value) -> value == 2))
    print(seq.toList().length())
    print(seq.toSet().has(3))
    print(seq.join(",", (Int value) -> str(value)))
    print(Sequences.range(1, 4).length())
    print(Sequences.rangeStep(0, 10, 3).length())
    print(Sequences.repeatValue(7, 3).length())
    print(Sequences.generate(3, () -> 9).get(0))
    print(Sequences.iterate(1, 4, (Int value) -> value * 2).get(3))
    print(Sequences.concat(Sequences.range(1, 3), Sequences.range(5, 7)).length())
    List<List<Int>> nested = [[1, 2], [], [3]]
    print(Sequences.flatten(nested).length())
    print(Sequences.fromNullable(8).length())
    Lazy<Int> lazy = new Lazy<Int>(() -> 5)
    print(lazy.get())
    print(lazy.isInitialized())
    print(lazy.toString())
    return 0
}
