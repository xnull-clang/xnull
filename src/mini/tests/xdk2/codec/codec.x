package xdk2.codec
import xdk.codec
import xdk.bytes
import xdk.errors
import xdk.io

static Int main() {
    // ---- JSON 解析 ----
    String json = "{\"name\":\"a\\u0042\",\"count\":42,\"num\":1.50,\"ok\":true,\"nil\":null,\"arr\":[1,2]}"
    Result<JsonValue, Error> parsed = Json.parse(json)
    print("json-ok=" + str(parsed.isOk()))
    JsonValue root = parsed.value()
    print("json-kind=" + jsonKindName(root.kind()))
    print("json-name=" + Json.getString(root, "name").value())
    print("json-count=" + str(Json.getInt(root, "count").value()))
    print("json-bool=" + str(Json.getBool(root, "ok").value()))
    print("json-arr0=" + str(Json.getInt(root, "arr.0").value()))
    JsonValue? numValue = Json.get(root, "num")
    JsonValue numJson = numValue as JsonValue
    JsonNumber? numOptional = numJson.asNumber()
    JsonNumber num = numOptional as JsonNumber
    print("json-num-raw=" + num.raw())
    print("json-num-int=" + str(num.isInteger()))
    print("json-num-double=" + str(num.asDouble().value()))
    print("json-num-asint-err=" + str(num.asInt().isErr()))
    print("json-null=" + str(root.isObject()))
    print("json-missing-err=" + str(Json.get(root, "missing") == null))
    print("json-getint-missing=" + str(Json.getInt(root, "missing").isErr()))
    print("json-getint-type=" + str(Json.getInt(root, "name").isErr()))
    Result<JsonObject, Error> objResult = Json.parseObject(json)
    print("json-parse-object=" + str(objResult.value().has("name")))
    Result<JsonArray, Error> arrResult = Json.parseArray("[1,2]")
    print("json-parse-array=" + str(arrResult.value().length()))
    print("json-parse-object-type=" + str(Json.parseObject("[1]").isErr()))
    print("json-bytes=" + str(Json.parseBytes(Bytes.fromString("true")).value().isBool()))
    Result<JsonValue, Error> emoji = Json.parse("\"\\uD83D\\uDE00\"")
    print("json-unicode-surrogate=" + str(Json.getString(emoji.value(), "").value().length()))

    // ---- 生成 ----
    print("json-stringify=" + Json.stringify(root))
    String pretty = Json.stringifyPretty(root)
    print("json-pretty-has-newline=" + str(pretty.indexOf("\n") >= 0))
    print("json-pretty-indent=" + str(pretty.indexOf("  \"name\"") >= 0))
    print("json-tobytes=" + str(Json.toBytes(root).length() == Json.stringify(root).length()))
    print("json-factory-object=" + str(Json.object().isObject()))
    print("json-factory-array=" + str(Json.array().isArray()))
    print("json-factory-string=" + Json.stringify(Json.string("a\"b\\c")))
    print("json-factory-number=" + Json.stringify(Json.number("-12.5e2")))
    print("json-factory-bool=" + Json.stringify(Json.bool(false)))
    print("json-factory-null=" + Json.stringify(Json.nullValue()))
    print("json-control-escape=" + Json.stringify(Json.string(fromCodePoint(1))))

    // ---- 非法/限制 ----
    print("json-bad=" + str(Json.parse("{").isErr()))
    print("json-trailing-data=" + str(Json.parse("1 2").isErr()))
    print("json-trailing-comma-default=" + str(Json.parse("[1,]").isErr()))
    print("json-comment-default=" + str(Json.parse("[1/*x*/]").isErr()))
    JsonOptions lax = new JsonOptions()
    lax = lax.allowTrailingComma(true)
    lax = lax.allowComments(true)
    print("json-trailing-comma-allow=" + str(Json.parseWithOptions("[1,]", lax).isOk()))
    print("json-comment-allow=" + str(Json.parseWithOptions("[1/*x*/]", lax).isOk()))
    JsonOptions depthOptions = new JsonOptions()
    depthOptions = depthOptions.maxDepth(2)
    print("json-depth=" + str(Json.parseWithOptions("[[[1]]]", depthOptions).isErr()))
    print("json-depth-ok=" + str(Json.parseWithOptions("[[1]]", depthOptions).isOk()))
    JsonOptions bytesOptions = new JsonOptions()
    bytesOptions = bytesOptions.maxBytes(3)
    print("json-bytes-limit=" + str(Json.parseWithOptions("1234", bytesOptions).isErr()))
    print("json-bad-escape=" + str(Json.parse("\"\\q\"").isErr()))
    JsonOptions copySource = new JsonOptions()
    copySource = copySource.maxDepth(5)
    print("json-options-copy=" + str(copySource.copy().getMaxDepth() == 5))
    JsonValue bigJson = Json.parse("9223372036854775808").value()
    JsonNumber? bigOptional = bigJson.asNumber()
    JsonNumber bigNumber = bigOptional as JsonNumber
    print("json-long-overflow=" + str(bigNumber.asLong().isErr()))
    JsonValue minJson = Json.parse("-9223372036854775808").value()
    JsonNumber? minOptional = minJson.asNumber()
    JsonNumber minNumber = minOptional as JsonNumber
    print("json-long-min=" + str(minNumber.asLong().isOk()))

    // ---- JsonObject / JsonArray ----
    JsonObject object = new JsonObject()
    object.set("a", Json.number("1"))
    object.set("b", Json.number("2"))
    object.set("a", Json.number("3"))
    print("object-order=" + str(object.keys().get(0)) + "," + str(object.keys().get(1)))
    print("object-len=" + str(object.length()))
    JsonValue? found = object.getOrNull("a")
    JsonValue foundValue = found as JsonValue
    print("object-get=" + str(foundValue.isNumber()))
    print("object-remove=" + str(object.remove("b")) + "," + str(object.remove("b")))
    print("object-keys=" + str(object.keys().length()))
    object.clear()
    print("object-clear=" + str(object.length()))

    JsonArray array = new JsonArray()
    array.add(Json.number("1"))
    array.add(Json.number("2"))
    print("array-len=" + str(array.length()))
    print("array-remove=" + str(array.remove(0).isNumber()) + "," + str(array.length()))
    print("array-copy=" + str(array.copy().length()))

    // ---- CSV ----
    String csvText = "a,b\n\"c,d\",\"e\nf\"\n"
    Result<List<List<String>>, Error> rowsResult = Csv.parse(csvText, new CsvOptions())
    List<List<String>> rows = rowsResult.value()
    print("csv-rows=" + str(rows.length()))
    print("csv-r0c1=" + rows.get(0).get(1))
    print("csv-quoted-comma=" + rows.get(1).get(0))
    print("csv-quoted-newline=" + str(rows.get(1).get(1).indexOf("\n") >= 0))
    String csvWritten = Csv.write(rows, new CsvOptions())
    print("csv-write=" + csvWritten.replace("\n", "\\n"))
    print("csv-empty-default=" + str(Csv.parse("a\n\nb\n", new CsvOptions()).value().length()))
    CsvOptions keepOptions = new CsvOptions()
    keepOptions = keepOptions.skipEmptyLines(false)
    print("csv-empty-keep=" + str(Csv.parse("a\n\nb\n", keepOptions).value().length()))
    CsvOptions trimOptions = new CsvOptions()
    trimOptions = trimOptions.trim(true)
    print("csv-trim=" + Csv.parse(" a , b ", trimOptions).value().get(0).get(0))
    CsvOptions semiOptions = new CsvOptions()
    semiOptions = semiOptions.delimiter(';')
    print("csv-delimiter=" + Csv.parse("a;b", semiOptions).value().get(0).get(1))
    print("csv-unterminated=" + str(Csv.parse("\"a", new CsvOptions()).isErr()))

    // ---- Base64 ----
    Bytes hi = Bytes.fromString("hi")
    print("base64=" + Base64.encode(hi))
    print("base64-url=" + Base64.encodeUrl(Bytes.fromString("hi")) )
    print("base64-nopad=" + Base64.encodeNoPadding(hi))
    Bytes special = fromHex("fbff")
    print("base64-special=" + Base64.encode(special))
    print("base64-special-url=" + Base64.encodeUrl(special))
    print("base64-len=" + str(Base64.encodedLength(1)) + "," + str(Base64.encodedLength(3)) + "," + str(Base64.encodedLength(4)))
    print("base64-declen=" + str(Base64.decodedLength(4)) + "," + str(Base64.decodedLength(8)))
    Result<Bytes, Error> decoded = Base64.decode("aGk=")
    Bytes decodedBytes = decoded.value()
    String decodedText = decodedBytes.toString()
    print("base64-decode=" + decodedText)
    Result<Bytes, Error> decodedUrl = Base64.decodeUrl("-_8=")
    print("base64-decode-url=" + str(decodedUrl.value().length()))
    Result<Bytes, Error> decodedNoPad = Base64.decodeNoPadding("aGk")
    Bytes decodedNoPadBytes = decodedNoPad.value()
    String decodedNoPadText = decodedNoPadBytes.toString()
    print("base64-decode-nopad=" + decodedNoPadText)
    print("base64-bad-char=" + str(Base64.decode("!!").isErr()))
    print("base64-bad-len=" + str(Base64.decode("aGk").isErr()))

    // ---- Hex ----
    print("hex=" + Hex.encode(Bytes.fromString("hi")))
    print("hex-upper=" + Hex.encodeUpper(Bytes.fromString("\u00ab")))
    print("hex-valid=" + str(Hex.isValid("6869")) + "," + str(Hex.isValid("686")))
    Result<Bytes, Error> hexDecoded = Hex.decode("6869")
    Bytes hexDecodedBytes = hexDecoded.value()
    String hexDecodedText = hexDecodedBytes.toString()
    print("hex-decode=" + hexDecodedText)
    print("hex-bad=" + str(Hex.decode("zz").isErr()))

    // ---- Reader / Writer ----
    Reader reader = new Reader(Bytes.fromString("x,y\n1,2\n"))
    Context context = Context.background()
    Result<JsonValue, Error> fromReader = Json.parseReader(context, new Reader(Bytes.fromString("true")))
    print("json-reader=" + str(fromReader.value().isBool()))
    CsvReader csvReader = new CsvReader(reader, new CsvOptions())
    Result<List<String>?, Error> firstRecord = csvReader.readRecord()
    List<String> firstValues = firstRecord.value() as List<String>
    print("csvreader-first=" + firstValues.get(0))
    Result<List<String>?, Error> secondRecord = csvReader.readRecord()
    List<String> secondValues = secondRecord.value() as List<String>
    print("csvreader-second=" + secondValues.get(1))
    Result<List<String>?, Error> eofRecord = csvReader.readRecord()
    print("csvreader-eof=" + str(eofRecord.value() == null))
    print("csvreader-close=" + str(csvReader.close().isOk()) + "," + str(csvReader.close().isOk()))
    print("csvreader-after-close=" + str(csvReader.readRecord().isErr()))

    Writer writer = new Writer()
    CsvWriter csvWriter = new CsvWriter(writer, new CsvOptions())
    List<String> row = ["a", "b,c"]
    print("csvwriter=" + str(csvWriter.writeRecord(row).isOk()))
    print("csvwriter-close=" + str(csvWriter.close().isOk()) + "," + str(csvWriter.close().isOk()))
    print("csvwriter-after-close=" + str(csvWriter.writeRecord(row).isErr()))
    Bytes writerBytes = writer.toBytes()
    String writerText = writerBytes.toString()
    print("csvwriter-text=" + writerText.replace("\n", "\\n"))
    return 0
}
