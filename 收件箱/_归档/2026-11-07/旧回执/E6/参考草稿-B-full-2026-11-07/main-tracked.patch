+func TestDevResourceCommand(t *testing.T) {
+	src := t.TempDir()
+	if err := os.WriteFile(filepath.Join(src, "a.txt"), []byte("hello"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	outPath := filepath.Join(t.TempDir(), "res_table.c")
+	code, _, errOut := run("dev", "res", src, outPath)
+	if code != exitcode.Success {
+		t.Fatalf("exit = %d, stderr=%s", code, errOut)
+	}
+	data, err := os.ReadFile(outPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(data, []byte(`"a.txt"`)) {
+		t.Fatalf("资源表缺少 a.txt：%s", data)
+	}
+}
+
+func TestDevRequiresSubcommand(t *testing.T) {
+	code, _, errOut := run("dev")
+	if code != exitcode.Usage {
+		t.Fatalf("exit = %d, want %d", code, exitcode.Usage)
+	}
+	if !strings.Contains(errOut, "xnull dev") {
+		t.Fatalf("缺少用法提示：%s", errOut)
+	}
+}
